@page "/"
@implements IDisposable
@inject LocalStore Store
@inject Recorder Rec
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AppUpdates Updates

<div class="page home">
    <header class="hero">
        <h1>Jotdash</h1>
        <div class="hero-actions">
            @if (Updates.Available is { } release)
            {
                <a class="icon-btn update-notification" href="menu?updates=true"
                   aria-label="@($"Jotdash {release.Version} update available. Open app updates.")"
                   title="Update available">
                    <Icon Name="update" />
                    <span class="update-badge" aria-hidden="true"></span>
                </a>
            }
            <button class="icon-btn details-toggle" aria-pressed="@Store.ShowTaskDetails"
                    aria-label="@(Store.ShowTaskDetails ? "Hide task details" : "Show task details")"
                    title="@(Store.ShowTaskDetails ? "Simple view" : "Show status legend and details")"
                    @onclick="ToggleDetails"><Icon Name="details" /></button>
            <a class="icon-btn" href="menu" aria-label="Menu"><Icon Name="more" /></a>
        </div>
    </header>

    @if (Rec.IsRecording)
    {
        <a class="banner recording" href="record"><span class="dot"></span> Recording… tap to return</a>
    }

    @if (Store.SelectedColor is { } color)
    {
        <button class="color-filter-active" @onclick="ClearColor" aria-label="Clear status color filter">
            <span class="state-dot" style="background:@color" aria-hidden="true"></span>Color filter on · Show all colors
        </button>
    }
    <section class="list" @ref="_list">
        @if (_tasks.Count == 0)
        {
            <div class="empty">
                <p class="empty-big">@(Store.SelectedColor is null ? "All clear" : "No matching tasks")</p>
                <p>@(Store.SelectedColor is null ? $"No tasks in {Store.SelectionName}. Tap a button below to capture a note, a voice memo or a photo."
                    : $"No tasks match this color in {Store.SelectionName}. Choose Show all colors to see the other tasks.")</p>
            </div>
        }
        @foreach (var t in _tasks)
        {
            <TaskCard Task="t" />
        }
    </section>

    @if (_error is not null)
    {
        <div class="toast" @onclick="() => _error = null">@_error</div>
    }

    <nav class="capture">
        <button class="cap" disabled="@_capturing" @onclick="TapPhoto" @onpointerdown="PressStart" @onpointerup="PressEnd"
                @onpointercancel="PressEnd" @onpointerleave="PressEnd" @oncontextmenu:preventDefault>
            <Icon Name="camera" /><span>Photo</span><small>hold for video</small>
        </button>
        <button class="cap" disabled="@_capturing" @onclick="NewNote">
            <Icon Name="edit" /><span>Note</span>
        </button>
        <button class="cap cap-voice" disabled="@_capturing" @onclick="NewVoice">
            <Icon Name="mic" /><span>Voice</span>
        </button>
    </nav>
</div>

@code {
    private void ToggleDetails()
    {
        try { Store.ToggleTaskDetails(); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        { _error = $"Could not change task details: {error.Message}"; }
    }

    private void ClearColor()
    {
        try { Store.SelectColor(null); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        { _error = $"Could not clear the color filter: {error.Message}"; }
    }

    private List<LocalTask> _tasks = new();
    private string? _error;
    private CancellationTokenSource? _press;
    private bool _longPressed;
    private bool _capturing;
    private ElementReference _list;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("jotdash.scrollToTop", _list);
    }

    protected override void OnInitialized()
    {
        _tasks = Store.Recent();
        Store.Changed += Refresh;
        Updates.Changed += RefreshUpdates;
    }

    private void Refresh() => InvokeAsync(() => { _tasks = Store.Recent(); StateHasChanged(); });
    private void RefreshUpdates() => InvokeAsync(StateHasChanged);

    private void NewNote() => Nav.NavigateTo("note");

    private void NewVoice()
    {
        Rec.TargetTaskId = null;
        Nav.NavigateTo("record");
    }

    // Tap = photo, press and hold = video.
    private async Task PressStart()
    {
        _longPressed = false;
        var cts = _press = new CancellationTokenSource();
        try { await Task.Delay(550, cts.Token); } catch (OperationCanceledException) { return; }
        _longPressed = true;
        await Capture(video: true);
    }

    private void PressEnd() => _press?.Cancel();

    private async Task TapPhoto()
    {
        if (_longPressed) { _longPressed = false; return; }
        _press?.Cancel();
        await Capture(video: false);
    }

    private async Task Capture(bool video)
    {
        if (_capturing) return;
        _capturing = true;
        try
        {
            if (await Tasks.CaptureAsync(Store, video) is { } id) Nav.NavigateTo($"task/{id}");
        }
        catch (Exception e) { _error = e.Message; }
        finally { _capturing = false; }
    }

    public void Dispose()
    {
        _press?.Cancel();
        Store.Changed -= Refresh;
        Updates.Changed -= RefreshUpdates;
    }
}
