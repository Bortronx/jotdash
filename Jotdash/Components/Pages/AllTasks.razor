@page "/tasks"
@implements IDisposable
@inject LocalStore Store
@inject IJSRuntime JS

<div class="page">
    <header class="bar">
        <a class="icon-btn" href="menu" aria-label="Back"><Icon Name="back" /></a>
        <div class="bar-title">All tasks</div>
        <span class="icon-btn"></span>
    </header>

    @if (Store.SelectedColor is { } color)
    {
        <button class="color-filter-active" @onclick="ClearColor" aria-label="Clear status color filter">
            <span class="state-dot" style="background:@color" aria-hidden="true"></span>Color filter on · Show all colors
        </button>
    }
    @if (_filterError is not null) { <p class="warn" role="alert">@_filterError</p> }
    <div class="tabs">
        <button class="tab @(!_done ? "active" : "")" @onclick="() => Show(false)">Open</button>
        <button class="tab @(_done ? "active" : "")" @onclick="() => Show(true)">Done</button>
    </div>

    <section class="list" @ref="_list">
        @if (_tasks.Count == 0)
        {
            <div class="empty"><p>@(Store.SelectedColor is not null ? "No tasks match this color." : _done ? "Nothing done yet." : "No open tasks.")</p></div>
        }
        @foreach (var t in _tasks.Take(_limit))
        {
            <TaskCard Task="t" />
        }
        @if (_tasks.Count > _limit)
        {
            <button class="btn btn-wide" @onclick="() => _limit += 50">Show more (@(_tasks.Count - _limit) left)</button>
        }
    </section>
</div>

@code {
    private bool _done;
    private string? _filterError;

    private void ClearColor()
    {
        try { Store.SelectColor(null); _filterError = null; }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        { _filterError = $"Could not clear the color filter: {error.Message}"; }
    }
    private int _limit = 50;
    private List<LocalTask> _tasks = new();
    private ElementReference _list;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("jotdash.scrollToTop", _list);
    }

    protected override void OnInitialized()
    {
        Show(false);
        Store.Changed += Refresh;
    }

    private void Show(bool done)
    {
        _done = done;
        _limit = 50;
        _tasks = Store.All(done);
    }

    private void Refresh() => InvokeAsync(() => { _tasks = Store.All(_done); StateHasChanged(); });

    public void Dispose() => Store.Changed -= Refresh;
}
