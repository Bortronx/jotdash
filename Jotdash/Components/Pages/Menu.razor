@page "/menu"
@implements IDisposable
@inject LocalStore Store
@inject SyncService Sync
@inject NavigationManager Nav

<div class="page">
    <header class="bar">
        <button class="icon-btn" @onclick="() => Nav.NavigateTo(Back)" aria-label="Back"><Icon Name="back" /></button>
        <div class="bar-title">Menu</div>
        <span class="icon-btn"></span>
    </header>

    <div class="panel">
        <label class="field">Workspace
            <select value="@Store.SelectedWorkspace" @onchange="PickWorkspace">
                @if (Store.SelectedWorkspace is null)
                {
                    <option value="">Choose a workspace</option>
                }
                else if (!Store.Meta.Workspaces.Any(w => w.Slug == Store.SelectedWorkspace))
                {
                    <option value="@Store.SelectedWorkspace">@Store.WorkspaceName (unavailable)</option>
                }
                @foreach (var workspace in Store.Meta.Workspaces)
                {
                    <option value="@workspace.Slug">@workspace.Name</option>
                }
            </select>
        </label>
        <p class="muted small">The start screen and All tasks show this workspace only. New notes, photos and voice notes go here.</p>
        @if (Store.Meta.Workspaces.Count == 0)
        {
            <p class="muted small">Connect and sync once to load workspaces. Local capture still works without a server.</p>
        }
        @if (_workspaceError is not null)
        {
            <p class="warn">@_workspaceError</p>
        }
    </div>

    <div class="panel">
        <div class="sync-line">
            @if (Sync.IsSyncing) { <span class="spin"><Icon Name="sync" /></span><b>Syncing…</b> }
            else if (Store.LastError is { } err) { <b class="warn">Not synced</b> }
            else if (Store.LastSync is null) { <b>Not synced yet</b> }
            else { <b class="ok">Synced @Tasks.Ago(Store.LastSync)</b> }
        </div>
        <div class="muted">
            @(Store.PendingCount == 0 ? "Nothing waiting to upload." : $"{Store.PendingCount} task(s) saved on this phone, waiting to upload.")
        </div>
        @if (Store.LastError is { } e && !Sync.IsSyncing)
        {
            <div class="muted small">@e</div>
        }
        <button class="btn btn-primary btn-wide" disabled="@Sync.IsSyncing" @onclick="SyncNow"><Icon Name="sync" />Sync now</button>
    </div>

    <nav class="menu-list">
        <a class="menu-item" href=""><Icon Name="home" />Start screen</a>
        <a class="menu-item" href="tasks"><Icon Name="list" />All tasks</a>
        <a class="menu-item" href="settings"><Icon Name="settings" />Settings</a>
    </nav>

    <p class="muted center small">Everything is saved on this phone first and synced to Plane in the background.</p>
</div>

@code {
    private string Back => "";
    private string? _workspaceError;

    protected override void OnInitialized()
    {
        Store.Changed += Refresh;
        Sync.StatusChanged += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task SyncNow() => await Task.Run(() => Sync.SyncAsync());

    private async Task PickWorkspace(ChangeEventArgs e)
    {
        if (e.Value is not string { Length: > 0 } workspace) return;
        try
        {
            Store.SelectWorkspace(workspace);
            _workspaceError = null;
            _workspaceError = await Task.Run(() => Sync.SyncAsync(refreshWorkspace: true));
        }
        catch (Exception error) { _workspaceError = error.Message; }
    }

    public void Dispose()
    {
        Store.Changed -= Refresh;
        Sync.StatusChanged -= Refresh;
    }
}
