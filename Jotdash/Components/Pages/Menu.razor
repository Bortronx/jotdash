@page "/menu"
@implements IDisposable
@inject LocalStore Store
@inject SyncService Sync
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page">
    <header class="bar">
        <button class="icon-btn" @onclick="GoBack" aria-label="Back"><Icon Name="back" /></button>
        <div class="bar-title">Menu</div>
        <span class="icon-btn"></span>
    </header>

    <div class="panel">
        <button class="btn btn-primary btn-wide" @onclick="() => _workspacePicker = true"><Icon Name="folder" />        Select workspace / project</button>
                <p class="muted">Current: <b>@Store.SelectionName</b></p>
                <p class="muted small">The start screen and All tasks show only this selection, and only it is downloaded. New notes, photos and voice notes go here.</p>
        @if (Store.Meta.Workspaces.Count == 0)
        {
            <p class="muted small">Connect and sync once to load workspaces. Local capture still works without a server.</p>
        }
        else if (!Store.SelectionAvailable)
        {
            <p class="warn">This selection is no longer available. Your cached notes stay saved. Choose another workspace or project to download tasks.</p>
        }
        @if (_workspaceError is not null)
        {
            <p class="warn">@_workspaceError</p>
        }
    </div>

    <div class="panel">
        <div class="sync-line">
            @if (Sync.IsSyncing) { <span class="spin"><Icon Name="sync" /></span><b>Syncing…</b> }
            else if (Store.LastError is { } err) { <b class="warn">Not synced</b> }
            else if (Store.LastSync is null) { <b>Not synced yet</b> }
            else { <b class="ok">Synced @Tasks.Ago(Store.LastSync)</b> }
        </div>
        <div class="muted">
            @(Store.PendingCount == 0 ? "Nothing waiting to upload." : $"{Store.PendingCount} task(s) saved on this phone, waiting to upload.")
        </div>
        @if (Store.LastError is { } e && !Sync.IsSyncing)
        {
            <div class="muted small">@e</div>
        }
        <button class="btn btn-primary btn-wide" disabled="@Sync.IsSyncing" @onclick="SyncNow"><Icon Name="sync" />Sync now</button>
    </div>

    <details class="panel color-options menu-disclosure">
        <summary>Filter by status color
            @if (Store.SelectedColor is { } color)
            {
                <span class="state-dot" style="background:@color" aria-hidden="true"></span>
                <small class="muted">On</small>
            }
        </summary>
        <p class="muted small">Hide other colors on the start screen and All tasks. This does not change tasks or synchronization.</p>
        <button class="sheet-item @(Store.SelectedColor is null ? "selected" : "")"
                aria-pressed="@(Store.SelectedColor is null)" @onclick="() => SelectColor(null)">
            <span>All colors</span>
            @if (Store.SelectedColor is null) { <Icon Name="check" /> }
        </button>
        @foreach (var option in Store.ColorOptions())
        {
            <button class="sheet-item @(Store.SelectedColor == option.Color ? "selected" : "")"
                    aria-pressed="@(Store.SelectedColor == option.Color)" @onclick="() => SelectColor(option.Color)">
                <span class="state-dot" style="background:@option.Color" aria-hidden="true"></span>
                <span>@option.Label <small class="muted">@option.Color</small></span>
                @if (Store.SelectedColor == option.Color) { <Icon Name="check" /> }
            </button>
        }
        @if (_colorError is not null) { <p class="warn" role="alert">@_colorError</p> }
    </details>

    <nav class="menu-list">
        <a class="menu-item" href=""><Icon Name="home" />Start screen</a>
        <a class="menu-item" href="tasks"><Icon Name="list" />All tasks</a>
        <a class="menu-item" href="settings"><Icon Name="settings" />Settings</a>
    </nav>

    <details class="panel menu-updates menu-disclosure" open="@ShowUpdates" @ref="_updatesSection">
        <summary><Icon Name="update" />App updates</summary>
        <UpdatePanel />
    </details>

    <p class="muted center small">Everything is saved on this phone first and synced to Plane in the background.</p>

    @if (_workspacePicker)
    {
        <div class="sheet-back" @onclick="() => _workspacePicker = false">
            <div class="sheet" @onclick:stopPropagation>
                <h2>Select workspace or project</h2>
                @foreach (var workspace in Store.Meta.Workspaces)
                {
                    <button class="sheet-item @(workspace.Slug == Store.SelectedWorkspace && Store.SelectedProject is null ? "selected" : "")"
                            @onclick="() => Pick(workspace.Slug, null)"><b>@workspace.Name</b> · entire workspace</button>
                    @foreach (var project in workspace.Projects)
                    {
                        <button class="sheet-item @(project.Id == Store.SelectedProject && workspace.Slug == Store.SelectedWorkspace ? "selected" : "")"
                                style="padding-left:2rem" @onclick="() => Pick(workspace.Slug, project.Id)">@project.Name</button>
                    }
                }
                @if (Store.Meta.Workspaces.Count == 0)
                {
                    <p class="muted">Sync with your server to load available workspaces. Your local notes stay saved.</p>
                    <button class="btn btn-primary btn-wide" disabled="@Sync.IsSyncing" @onclick="SyncNow"><Icon Name="sync" />Load workspaces</button>
                }
                <button class="btn btn-wide" @onclick="() => _workspacePicker = false">Close</button>
            </div>
        </div>
    }
</div>

@code {
    private string Back => "";
    [Parameter, SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "selectWorkspace")] public bool SelectWorkspace { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "updates")] public bool ShowUpdates { get; set; }
    private string? _workspaceError;
    private string? _colorError;
    private bool _workspacePicker;
    private bool _scrollToUpdates;
    private ElementReference _updatesSection;

    protected override void OnParametersSet()
    {
        _workspacePicker = SelectWorkspace;
        _scrollToUpdates = ShowUpdates;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToUpdates) return;
        _scrollToUpdates = false;
        await JS.InvokeVoidAsync("jotdash.scrollIntoView", _updatesSection);
    }

    protected override void OnInitialized()
    {
        Store.Changed += Refresh;
        Sync.StatusChanged += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void GoBack() => Nav.NavigateTo(SafeReturnTo(ReturnTo) ? ReturnTo! : Back);

    private static bool SafeReturnTo(string? route)
    {
        if (route == "note") return true;
        const string prefix = "task/";
        return route is not null
            && route.StartsWith(prefix, StringComparison.Ordinal)
            && route.Length > prefix.Length
            && route[prefix.Length..].All(c => char.IsAsciiLetterOrDigit(c) || c == '-');
    }

    private async Task SyncNow() => await Task.Run(() => Sync.SyncAsync());

    private void SelectColor(string? color)
    {
        try { Store.SelectColor(color); _colorError = null; }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or ArgumentException)
        { _colorError = $"Could not save the color filter: {error.Message}"; }
    }

    private async Task Pick(string workspace, string? project)
    {
        try
        {
            Store.SelectWorkspace(workspace, project);
            _workspacePicker = false;
            _workspaceError = null;
            _workspaceError = await Task.Run(() => Sync.SyncAsync(refreshWorkspace: true));
        }
        catch (Exception error) { _workspaceError = error.Message; }
    }

    public void Dispose()
    {
        Store.Changed -= Refresh;
        Sync.StatusChanged -= Refresh;
    }
}
